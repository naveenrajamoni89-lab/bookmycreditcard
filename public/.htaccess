# ------------------------------------------------------------------------------
# BookMyCreditCard - Hostinger Apache / LiteSpeed Configuration
# ------------------------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite if request matches an existing file
  #    (Ensures JS, CSS, images, robots.txt, sitemap.xml, 404.html are served directly)
  RewriteCond %{REQUEST_FILENAME} -f [OR]

  # 2. Do not rewrite if request matches an existing directory
  #    (Ensures the 230 static route folders generated by build are served directly!)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Fallback: Route all other requests to root index.html
  #    (Allows React Router to handle dynamic client-side routes)
  RewriteRule ^ index.html [L]
</IfModule>

# Caching headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
